{
  "expo": {
    "name": "Fintranzact",
    "slug": "fintranzact",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fintranzact",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.fintranzact.app",
      "associatedDomains": [
        "applinks:app.fintranzact.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5b5bd6"
      },
      "package": "in.fintranzact.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.fintranzact.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-system-ui",
      "expo-local-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Fintranzact needs access to your contacts to help you create invoices faster."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
