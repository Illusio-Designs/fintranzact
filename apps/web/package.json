{
  "name": "@fintranzact/web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:help-index": "tsx scripts/gen-help-index.ts",
    "build": "tsx scripts/gen-help-index.ts && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:api-reference": "node scripts/check-api-reference.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:help-platform": "tsx scripts/check-help-platform-coverage.ts",
    "test:a11y": "vitest run --reporter=verbose --testNamePattern=ACCESSIBILITY"
  },
