{
  "name": "fintranzact",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@fintranzact/mobile --filter=!@fintranzact/mcp --filter=!@fintranzact/cli",
    "dev:mobile": "pnpm --filter @fintranzact/mobile dev",
    "dev:mobile:android": "pnpm --filter @fintranzact/mobile dev:android",
    "build": "turbo build",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "pnpm --filter @fintranzact/db db:push",
    "db:reset": "pnpm --filter @fintranzact/db db:reset",
    "db:studio": "pnpm --filter @fintranzact/db studio",
    "lint": "pnpm exec oxlint --deny-warnings --ignore-path .gitignore --ignore-pattern '**/target/**' ./packages ./apps",
    "licenses:check": "node scripts/license-check.mjs",
    "audit:prod": "pnpm --filter @fintranzact/api exec tsx src/bin/audit-check.ts",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency 1",
    "test:api": "pnpm --filter @fintranzact/shared test && pnpm --filter @fintranzact/api test",
    "test:web": "pnpm --filter @fintranzact/web test",
    "test:mobile": "pnpm --filter @fintranzact/mobile test",
    "test:e2e": "pnpm exec playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm exec playwright test --config e2e/playwright.config.ts --ui",
    "sandbox:smoke": "npx tsx scripts/sandbox-smoke.ts",
    "data:audit": "pnpm --filter @fintranzact/api data:audit",
    "preflight": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:api",
    "release": "bash scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jszip": "^3.10.2",
    "oxlint": "^1.87.0",
    "postgres": "^3.4.9",
    "turbo": "^2.11.7",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "lodash": ">=4.18.1",
      "@modelcontextprotocol/sdk@<1.31.0": "^1.31.0",
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "browserslist@<4.28.7": "^4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "fast-uri@<3.1.7": "^3.1.7",
      "hono@<4.12.25": "^4.12.25",
      "ip-address@<10.3.1": "^10.3.1",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "nanoid@>=5.0.0 <5.1.16": "^5.1.16",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.18": "^8.5.18",
      "proxy-addr@<2.0.8": "^2.0.8",
      "seroval@<1.6.3": "^1.6.3",
      "shell-quote@<1.9.0": "^1.9.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "ws@>=7.0.0 <7.5.11": "^7.5.11"
    }
  },
  "version": "0.9.0"
}
