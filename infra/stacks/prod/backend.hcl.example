# Copy to backend.hcl (not committed) and fill in the values printed by
# `terraform output` in infra/bootstrap.
#
#   terraform init -backend-config=backend.hcl
bucket         = "fintranzact-tfstate-123456789012"
key            = "prod/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "fintranzact-tfstate-lock"
encrypt        = true
