# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://fintranzact:your_secure_password@localhost:5432/fintranzact

# ── API Server ──────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=http://localhost:5173,https://your-domain.pages.dev

# ── Node environment ────────────────────────────────────────────
NODE_ENV=development

# ── App URL (used for email links) ────────────────────────
APP_URL=http://localhost:5173
# Origin of the public storefront (optional). Where shoppers return after paying an order online and where order emails link.
# STORE_URL=https://store.example.com
# Public origin of the API server (optional). Shown in the Razorpay webhook URL a business adds in its own dashboard.
# API_URL=http://localhost:3001

# ── Email (optional — email-change links print to console if not set)
RESEND_API_KEY=
EMAIL_FROM=Fintranzact <noreply@yourdomain.com>
# Inbox for the public contact and partner forms (default support@fintranzact.com).
# Without RESEND_API_KEY the submissions are written to the API log instead.
CONTACT_INBOX=

# ── Payment reminder SMS (optional; SMS reminders are off without it) ──
# Needs an MSG91 account and a DLT-registered sender ID and template (India).
# Email reminders use RESEND_API_KEY above. PAYMENT_REMINDERS=off stops the reminder job.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Comma list of the template's variable names (default: customerName,invoiceNumber,amount,dueDate,businessName)
MSG91_TEMPLATE_VARS=

# ── Platform admin (sees every organisation at /platform) ───
# The account is created at start-up if it does not exist yet (already
# verified). The password is only used for that first creation — change it
# afterwards in the app. Extra admin emails must verify themselves by signing
# in once with an emailed link.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=
# PLATFORM_ADMIN_EMAILS=second.admin@example.com

# ── Multi-tenancy (cloud SaaS only) ───────────────────────────
MULTI_TENANT=false
CONTROL_DATABASE_URL=

# ── Field-Level Encryption ────────────────────────────────────
# AES-256-GCM key for encrypting sensitive fields at rest (e-invoice credentials,
# carrier API keys, tenant DB passwords). REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Previous encryption key — set ONLY during key rotation. Remove after rotation completes.
ENCRYPTION_KEY_PREVIOUS=
# Legacy alias (still supported): DB_ENCRYPTION_KEY is accepted if ENCRYPTION_KEY is not set.
# DB_ENCRYPTION_KEY=

# ── Sandbox.co.in (GST e-invoice, e-way bill, GSTIN lookup, TDS/TCS) ──
# One gateway for government APIs. Keys come from console.sandbox.co.in:
#   key_test_… -> https://test-api.sandbox.co.in   key_live_… -> https://api.sandbox.co.in
# Each business still stores its own portal API login (username/password/GSTIN) encrypted.
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# Smoke-test these keys against the Sandbox TEST host with `pnpm sandbox:smoke` (read-only checks;
# refuses key_live_ keys unless --allow-live). It reads only SANDBOX_* from here or the shell, never from
# arguments, and never prints them. Paste the printed report back, never this file.
# Optional: override the host (proxy / local mock), or pin an API version.
# SANDBOX_BASE_URL=
# SANDBOX_API_VERSION=
# Plan quota (successful calls/month) for alerts at 80% and 100%. Unset = no alerts.
# SANDBOX_MONTHLY_QUOTA=
# HSN / SAC lookup on Sandbox when an item is saved (falls back to the bundled list). on|off, default on.
# HSN_SANDBOX_LOOKUP=on
# HSN_LOOKUP_TIMEOUT_MS=2500
# GSTIN search on Sandbox when a party is added or saved (local validation only without keys). on|off, default on.
# GSTIN_SANDBOX_LOOKUP=on
# GSTIN_LOOKUP_TIMEOUT_MS=2500
# Daily re-check of the HSN / SAC codes items use, kept as a fallback layer (needs Sandbox keys). on|off, default on.
# HSN_REFRESH=on
# HSN_REFRESH_BATCH=200
# direct = force the direct NIC client even with Sandbox keys; sandbox = force Sandbox.
# GOV_API_PROVIDER=
# Per-document customer prices in paise, before GST (defaults: 200, 200, 0, 0).
# GOV_RATE_E_INVOICE_PAISE=200
# GOV_RATE_E_WAY_BILL_PAISE=200
# GOV_RATE_GSTR1_PAISE=0
# GOV_RATE_GSTR3B_PAISE=0

# ── Shipping Webhook Secret ──────────────────────────────────
# HMAC-SHA256 secret for verifying shipping carrier webhook signatures.
SHIPPING_WEBHOOK_SECRET=

# ── Subscription billing (Razorpay) ──────────────────────────
# With no keys set, the demo checkout runs instead (always in development;
# in production only when DEMO_PAYMENTS=true). Setting both keys switches
# plan and add-on checkout to real Razorpay subscriptions.
# RAZORPAY_KEY_ID=      (RAZORPAY_KEY is accepted too)
# RAZORPAY_KEY_SECRET=  (RAZORPAY_SECRET is accepted too)
# Secret of the Razorpay webhook (Dashboard → Webhooks → /webhooks/razorpay).
# RAZORPAY_WEBHOOK_SECRET=
# DEMO_PAYMENTS=false
# Printed on the GST invoices Finvera Solutions LLP issues for subscriptions.
# FINVERA_GSTIN=
# FINVERA_STATE_CODE=24
# FINVERA_ADDRESS=

# ── Tenant Pool (multi-tenant mode) ───────────────────────────
# TENANT_POOL_MAX=50           # Max cached tenant DB pools (LRU eviction)
# TENANT_POOL_PER_DB_MAX=5     # Connections per tenant pool
# UV_THREADPOOL_SIZE=8          # Prevent Argon2id from saturating libuv pool

# ── Cloudflare Turnstile (online store bot protection) ────────
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=        # Backend secret key (required in production)
VITE_TURNSTILE_SITE_KEY=     # Frontend site key (required in production)

# ── Public web address (sitemap, canonical URLs, link previews) ─
# Defaults to https://fintranzact-web.vercel.app when unset.
VITE_SITE_URL=

# ── E2E / Test Harness ────────────────────────────────────────
# Set to "1" to bypass the tRPC rate limiter (used by the Playwright
# harness, which seeds data in tight bursts). Ignored in production.
# DISABLE_RATE_LIMIT=1

# ── AI business assistant (paid add-on) ────────────────────────
# Server-side only: never exposed to clients, never logged. Create a key at
# https://console.anthropic.com and set a monthly spend limit there. Without
# it the assistant answers "not configured". See docs/architecture/ai-assistant.md.
# ANTHROPIC_API_KEY=
# Cheaper, faster model for simple questions (default claude-haiku-4-5-20251001)
# AI_MODEL_FAST=claude-haiku-4-5-20251001
# Stronger model for comparisons and multi-step analysis (default claude-sonnet-5-5)
# AI_MODEL_STRONG=claude-sonnet-5-5
