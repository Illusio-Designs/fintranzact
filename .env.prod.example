# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=fintranzact
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fintranzact

# ── API Server ──────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com

# ── Field-Level Encryption (REQUIRED) ──────────────────────────
# AES-256-GCM key for encrypting sensitive data at rest (e-invoice and e-way bill credentials, carrier
# API keys, each business's Razorpay keys, 2FA secrets, share-link tokens, tenant DB passwords).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotate it yearly with the procedure in docs/security/key-rotation.md: old key into
# ENCRYPTION_KEYS_PREVIOUS, new key here, deploy, run the rotate-encryption-key tool, verify, then
# remove the old key. Never just replace the key: stored credentials would become unreadable.
ENCRYPTION_KEY=
# Optional label for the current key (letters, digits, - and _). Default: a fingerprint of the key.
# ENCRYPTION_KEY_ID=
# Old keys, decrypt-only, comma separated (64-hex, or label=64-hex). Keep until the rotation tool has
# finished AND the backups that need them have aged out.
# ENCRYPTION_KEYS_PREVIOUS=

# ── Sandbox.co.in (GST e-invoice, e-way bill, GSTIN lookup, TDS/TCS) ──
# From console.sandbox.co.in. Use key_live_… in production.
# Each business still saves its own e-invoice / e-way bill portal login in Settings.
SANDBOX_API_KEY=key_live_xxxxxxxx
SANDBOX_API_SECRET=
# Emergency rollback to the direct NIC client: GOV_API_PROVIDER=direct
# GOV_API_PROVIDER=
# Your Sandbox plan quota (successful calls/month); alerts at 80% and 100%.
SANDBOX_MONTHLY_QUOTA=
# Per-document customer prices in paise, before GST.
GOV_RATE_E_INVOICE_PAISE=200
GOV_RATE_E_WAY_BILL_PAISE=200
GOV_RATE_GSTR1_PAISE=0
GOV_RATE_GSTR3B_PAISE=0

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Fintranzact <noreply@yourdomain.com>

# ── Cloudflare Turnstile ────────────────────────────────────────
TURNSTILE_SECRET_KEY=0x4AAA...

# ── Multi-tenancy (leave false for self-hosted) ─────────────────
MULTI_TENANT=false

# ── Backup ─────────────────────────────────────────────────────
# Encryption key for backup files (passphrase for age encryption)
# Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# R2/S3 offsite backup storage (optional — backups still saved locally without this)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=fintranzact-backups
# Cron schedule for automated backups (default: daily 2 AM UTC)
BACKUP_CRON=0 2 * * *
# Local backup retention in days
BACKUP_RETENTION_DAYS=30
