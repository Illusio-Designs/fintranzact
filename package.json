{
  "name": "fintranzact",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@fintranzact/mobile --filter=!@fintranzact/mcp --filter=!@fintranzact/cli",
    "dev:mobile": "pnpm --filter @fintranzact/mobile dev",
    "dev:mobile:android": "pnpm --filter @fintranzact/mobile dev:android",
    "build": "turbo build",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "pnpm --filter @fintranzact/db db:push",
    "db:reset": "pnpm --filter @fintranzact/db db:reset",
    "db:studio": "pnpm --filter @fintranzact/db studio",
    "lint": "pnpm exec oxlint --deny-warnings --ignore-path .gitignore --ignore-pattern '**/target/**' ./packages ./apps",
    "licenses:check": "node scripts/license-check.mjs",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency 1",
    "test:api": "pnpm --filter @fintranzact/shared test && pnpm --filter @fintranzact/api test",
    "test:web": "pnpm --filter @fintranzact/web test",
    "test:mobile": "pnpm --filter @fintranzact/mobile test",
    "test:e2e": "pnpm exec playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm exec playwright test --config e2e/playwright.config.ts --ui",
    "data:audit": "pnpm --filter @fintranzact/api data:audit",
    "preflight": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:api",
    "release": "bash scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "oxlint": "^1.56.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "lodash": ">=4.18.1"
    }
  },
  "version": "0.9.0"
}
